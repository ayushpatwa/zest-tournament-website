rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. App Releases & Version Updates: Anyone can read, only updates allowed for latest release
    match /app_releases/{document} {
      allow read: if true;
      allow write: if true; // Permanent read & write access
    }

    // 2. Tournament matches & registrations: Anyone can view schedules
    match /tournaments/{document} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Hall of Fame leaderboard standings: Public read
    match /leaderboard/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
